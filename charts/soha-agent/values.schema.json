{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "agent",
        "outpost"
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "secrets": {
      "type": "object",
      "properties": {
        "agentBearerToken": {
          "$ref": "#/definitions/generatedSecret"
        },
        "controlPlaneBearerToken": {
          "$ref": "#/definitions/generatedSecret"
        },
        "controlPlaneExistingSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "prometheusBearerToken": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "security": {
          "type": "object",
          "properties": {
            "allowedActions": {
              "type": [
                "array",
                "null"
              ],
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "In auto and custom profiles, use an explicit action list or [] to deny all actions. Omitted or null uses the legacy default list."
            },
            "profile": {
              "type": "string",
              "enum": [
                "auto",
                "custom",
                "workbench",
                "read-only"
              ],
              "description": "auto and custom honor explicit action lists. workbench selects the default workbench action set. read-only disables writes and execution."
            }
          }
        },
        "loggerLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "loggerFormat": {
          "type": "string",
          "enum": [
            "json",
            "console"
          ]
        },
        "controlPlane": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string",
              "minLength": 1
            },
            "agentId": {
              "type": "string",
              "minLength": 1
            },
            "runtimeEndpoint": {
              "type": "string",
              "minLength": 1
            },
            "outpost": {
              "type": "object",
              "properties": {
                "agentId": {
                  "type": "string"
                },
                "protocolVersion": {
                  "type": "string",
                  "enum": [
                    "v1"
                  ]
                },
                "trustKeyId": {
                  "type": "string"
                },
                "trustPublicKey": {
                  "type": "string"
                },
                "pollInterval": {
                  "type": "string",
                  "minLength": 1
                },
                "heartbeatInterval": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            }
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "customResourceRules": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "apiGroup",
              "resources",
              "verbs"
            ],
            "properties": {
              "apiGroup": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
                "maxLength": 253
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$",
                  "maxLength": 63
                }
              },
              "verbs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "get",
                    "list",
                    "watch",
                    "create",
                    "update",
                    "patch",
                    "delete"
                  ]
                }
              },
              "namespaces": {
                "type": "array",
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                  "maxLength": 63
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "outpost"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "controlPlane": {
                "properties": {
                  "outpost": {
                    "properties": {
                      "agentId": {
                        "minLength": 1
                      },
                      "trustKeyId": {
                        "minLength": 1
                      },
                      "trustPublicKey": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "agentId",
                      "protocolVersion",
                      "trustKeyId",
                      "trustPublicKey"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "generatedSecret": {
      "type": "string",
      "oneOf": [
        {
          "const": ""
        },
        {
          "minLength": 32
        }
      ]
    }
  }
}

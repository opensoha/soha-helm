{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["profile", "workspaceId", "clusterId", "environment", "collector", "loki", "persistence"],
  "properties": {
    "profile": { "type": "string", "enum": ["collector_only", "starter", "production_external"] },
    "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "clusterId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "environment": { "type": "string", "maxLength": 128 },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "collector": {
      "type": "object",
      "required": ["enabled", "podLogGroupId", "signalAllowlist", "image", "namespaceAllowlist", "otlp", "destination", "metrics", "traces", "redaction", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "podLogGroupId": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "signalAllowlist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["logs", "metrics", "traces"] }
        },
        "image": { "$ref": "#/definitions/image" },
        "namespaceAllowlist": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 253 }
        },
        "otlp": {
          "type": "object",
          "required": ["enabled", "existingSecret"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": { "type": "string", "maxLength": 253 }
          }
        },
        "destination": {
          "type": "object",
          "required": ["endpoint", "tenantId", "existingSecret"],
          "properties": {
            "endpoint": { "type": "string", "maxLength": 2048 },
            "tenantId": { "type": "string", "maxLength": 256 },
            "existingSecret": { "type": "string", "maxLength": 253 }
          }
        },
        "metrics": { "$ref": "#/definitions/signalDestination" },
        "traces": { "$ref": "#/definitions/signalDestination" },
        "redaction": {
          "type": "object",
          "required": ["deleteAttributes", "hashAttributes"],
          "properties": {
            "deleteAttributes": { "$ref": "#/definitions/attributeNames" },
            "hashAttributes": { "$ref": "#/definitions/attributeNames" }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "loki": {
      "type": "object",
      "required": ["enabled", "image", "retentionDays", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "resources": { "type": "object" }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "storageClassName", "storageSize"],
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClassName": { "type": "string", "maxLength": 253 },
        "storageSize": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "starter" } }, "required": ["profile"] },
      "then": {
        "properties": {
          "loki": { "properties": { "enabled": { "const": true } } },
          "persistence": { "properties": { "enabled": { "const": true } } }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "enum": ["collector_only", "production_external"] } }, "required": ["profile"] },
      "then": {
        "properties": {
          "collector": {
            "properties": {
              "destination": { "properties": { "endpoint": { "minLength": 1, "format": "uri" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "collector": { "properties": { "otlp": { "properties": { "enabled": { "const": true } } } } }
        }
      },
      "then": {
        "properties": {
          "collector": {
            "properties": {
              "otlp": { "properties": { "existingSecret": { "minLength": 1 } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "collector": { "properties": { "signalAllowlist": { "contains": { "const": "metrics" } } } }
        }
      },
      "then": {
        "properties": {
          "collector": {
            "properties": {
              "otlp": { "properties": { "enabled": { "const": true } } },
              "metrics": { "properties": { "endpoint": { "minLength": 1, "format": "uri" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "collector": { "properties": { "signalAllowlist": { "contains": { "const": "traces" } } } }
        }
      },
      "then": {
        "properties": {
          "collector": {
            "properties": {
              "otlp": { "properties": { "enabled": { "const": true } } },
              "traces": { "properties": { "endpoint": { "minLength": 1, "format": "uri" } } }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "attributeNames": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "signalDestination": {
      "type": "object",
      "required": ["endpoint", "existingSecret"],
      "properties": {
        "endpoint": { "type": "string", "maxLength": 2048 },
        "existingSecret": { "type": "string", "maxLength": 253 },
        "insecure": { "type": "boolean" }
      }
    }
  }
}

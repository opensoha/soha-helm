{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "password": {
          "$ref": "#/definitions/initialCredential"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "loggerLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "loggerFormat": {
          "type": "string",
          "enum": ["json", "console"]
        },
        "maxHeaderBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "runtime": {
          "type": "object",
          "properties": {
            "executionRunnerToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "adminPassword": {
              "$ref": "#/definitions/initialCredential"
            },
            "jwtSecret": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "webhookToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "modules": {
          "type": "object",
          "properties": {
            "delivery": {
              "$ref": "#/definitions/moduleToggle"
            },
            "monitoring": {
              "$ref": "#/definitions/moduleToggle"
            },
            "ai": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "features": {
                  "type": "object",
                  "properties": {
                    "globalAssistant": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "aiGateway": {
              "$ref": "#/definitions/moduleToggle"
            },
            "virtualization": {
              "$ref": "#/definitions/moduleToggle"
            },
            "docker": {
              "$ref": "#/definitions/moduleToggle"
            },
            "security": {
              "$ref": "#/definitions/moduleToggle"
            },
            "cmdb": {
              "$ref": "#/definitions/moduleToggle"
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "credentialEncryptionKey": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["host"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "port": {
                "const": 5432
              }
            },
            "required": ["port"]
          }
        }
      }
    }
  ],
  "definitions": {
    "moduleToggle": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "initialCredential": {
      "type": "string",
      "minLength": 1
    },
    "systemSecret": {
      "type": "string",
      "minLength": 32
    }
  }
}

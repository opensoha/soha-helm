{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "password": {
          "$ref": "#/definitions/initialCredential"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "maxHeaderBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "runtime": {
          "type": "object",
          "properties": {
            "executionRunnerToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "adminPassword": {
              "$ref": "#/definitions/initialCredential"
            },
            "jwtSecret": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "webhookToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "modules": {
          "type": "object",
          "properties": {
            "virtualization": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "credentialEncryptionKey": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["host"]
          }
        }
      }
    }
  ],
  "definitions": {
    "initialCredential": {
      "type": "string",
      "minLength": 1
    },
    "systemSecret": {
      "type": "string",
      "minLength": 32
    }
  }
}

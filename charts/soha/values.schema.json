{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "password": {
          "$ref": "#/definitions/initialCredential"
        }
      }
    },
    "networkRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingTLSSecret", "control", "ingest", "ingestPostgres"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingTLSSecret": {
          "type": "string",
          "maxLength": 253
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "service": { "$ref": "#/definitions/networkRuntimeService" }
          }
        },
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "service": { "$ref": "#/definitions/networkRuntimeService" }
          }
        },
        "ingestPostgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "database", "username", "password", "storageClass", "storageSize"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "database": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "$ref": "#/definitions/initialCredential" },
            "storageClass": { "type": "string" },
            "storageSize": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "loggerLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "loggerFormat": {
          "type": "string",
          "enum": ["json", "console"]
        },
        "maxHeaderBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "runtime": {
          "type": "object",
          "properties": {
            "executionRunnerToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "adminPassword": {
              "$ref": "#/definitions/initialCredential"
            },
            "jwtSecret": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "webhookToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "networkIngestQuery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "url",
            "serverName",
            "existingSecret",
            "timeout",
            "maxResponseBytes"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "maxLength": 2048
            },
            "serverName": {
              "type": "string",
              "maxLength": 253
            },
            "existingSecret": {
              "type": "string",
              "maxLength": 253
            },
            "timeout": {
              "type": "string",
              "minLength": 1
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 4194304
            }
          }
        },
        "modules": {
          "type": "object",
          "properties": {
            "delivery": {
              "$ref": "#/definitions/moduleToggle"
            },
            "monitoring": {
              "$ref": "#/definitions/moduleToggle"
            },
            "ai": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "features": {
                  "type": "object",
                  "properties": {
                    "globalAssistant": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "aiGateway": {
              "$ref": "#/definitions/moduleToggle"
            },
            "virtualization": {
              "$ref": "#/definitions/moduleToggle"
            },
            "docker": {
              "$ref": "#/definitions/moduleToggle"
            },
            "security": {
              "$ref": "#/definitions/moduleToggle"
            },
            "cmdb": {
              "$ref": "#/definitions/moduleToggle"
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "credentialEncryptionKey": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["host"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "port": {
                "const": 5432
              }
            },
            "required": ["port"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "networkIngestQuery": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["networkIngestQuery"]
          }
        },
        "required": ["config"]
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "networkIngestQuery": {
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "serverName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "networkRuntime": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["networkRuntime"]
      },
      "then": {
        "properties": {
          "networkRuntime": {
            "properties": {
              "existingTLSSecret": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "networkRuntimeService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "moduleToggle": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "initialCredential": {
      "type": "string",
      "minLength": 1
    },
    "systemSecret": {
      "type": "string",
      "minLength": 32
    }
  }
}

{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "password": {
          "$ref": "#/definitions/initialCredential"
        }
      }
    },
    "networkRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingTLSSecret", "control", "ingest", "ingestPostgres"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingTLSSecret": {
          "type": "string",
          "maxLength": 253
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "service": { "$ref": "#/definitions/networkRuntimeService" }
          }
        },
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "service": { "$ref": "#/definitions/networkRuntimeService" }
          }
        },
        "ingestPostgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "database", "username", "password", "storageClass", "storageSize"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "database": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "$ref": "#/definitions/initialCredential" },
            "storageClass": { "type": "string" },
            "storageSize": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "loggerLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        },
        "loggerFormat": {
          "type": "string",
          "enum": ["json", "console"]
        },
        "maxHeaderBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "runtime": {
          "type": "object",
          "properties": {
            "executionRunnerToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "adminPassword": {
              "$ref": "#/definitions/initialCredential"
            },
            "jwtSecret": {
              "$ref": "#/definitions/systemSecret"
            },
            "cli": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "publicURL",
                "allowPassword",
                "deviceTTL",
                "pollInterval",
                "accessTTL",
                "idleTTL",
                "absoluteTTL",
                "createLimit",
                "sourcePendingLimit",
                "activeGrantLimit",
                "sourceAttemptLimit",
                "userAttemptLimit"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "publicURL": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^$|^(https://(\\[[^\\[\\]/?#@\\s\\\\]+\\]|[^/:?#@\\s\\\\\\[\\]]+)(:[0-9]+)?|http://(localhost|127\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|\\[::1\\])(:[0-9]+)?)(/[^?#\\s\\\\]*)?$",
                  "description": "External console URL, including its console prefix. HTTPS is required except for canonical localhost, 127.0.0.0/8 or [::1] loopback addresses. This is separate from config.basePath, which is the API path. Core performs final URL validation."
                },
                "allowPassword": {
                  "type": "boolean"
                },
                "deviceTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Device lifetime, 30s..10m; zero uses the Core default of 5m."
                },
                "pollInterval": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Polling interval, 1s..30s; zero uses the Core default of 5s."
                },
                "accessTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Access lifetime, at least 1s and no greater than idleTTL; zero uses 15m."
                },
                "idleTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Sliding idle lifetime, at least accessTTL and no greater than absoluteTTL; zero uses 168h."
                },
                "absoluteTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Absolute lifetime, at least idleTTL and at most 8760h (365 days); zero uses 720h."
                },
                "createLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "sourcePendingLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "activeGrantLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "sourceAttemptLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "userAttemptLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  },
                  "then": {
                    "properties": {
                      "publicURL": {
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "webhookToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "networkIngestQuery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "url",
            "serverName",
            "existingSecret",
            "timeout",
            "maxResponseBytes"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "maxLength": 2048
            },
            "serverName": {
              "type": "string",
              "maxLength": 253
            },
            "existingSecret": {
              "type": "string",
              "maxLength": 253
            },
            "timeout": {
              "type": "string",
              "minLength": 1
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 4194304
            }
          }
        },
        "modules": {
          "type": "object",
          "properties": {
            "delivery": {
              "$ref": "#/definitions/moduleToggle"
            },
            "monitoring": {
              "$ref": "#/definitions/moduleToggle"
            },
            "ai": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "features": {
                  "type": "object",
                  "properties": {
                    "globalAssistant": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "aiGateway": {
              "$ref": "#/definitions/moduleToggle"
            },
            "virtualization": {
              "$ref": "#/definitions/moduleToggle"
            },
            "docker": {
              "$ref": "#/definitions/moduleToggle"
            },
            "security": {
              "$ref": "#/definitions/moduleToggle"
            },
            "cmdb": {
              "$ref": "#/definitions/moduleToggle"
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "credentialEncryptionKey": {
              "$ref": "#/definitions/systemSecret"
            },
            "protectedDurableStorage": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "dshRuntime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "gatewayURL": {
          "type": "string"
        },
        "callbackURL": {
          "type": "string"
        },
        "models": {
          "type": "string",
          "const": "soha-workbench"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageSize": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "pluginAssets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": {
              "type": "string"
            },
            "skillFiles": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "maxLength": 253
              }
            },
            "credentialSecret": {
              "type": "string"
            }
          },
          "if": {
            "anyOf": [
              {
                "properties": {
                  "skillFiles": { "minProperties": 1 }
                },
                "required": ["skillFiles"]
              },
              {
                "properties": {
                  "credentialSecret": { "minLength": 1 }
                },
                "required": ["credentialSecret"]
              }
            ]
          },
          "then": {
            "properties": {
              "configMap": { "minLength": 1 }
            },
            "required": ["configMap"]
          }
        },
        "resources": {
          "type": "object"
        },
        "baseURL": {
          "type": "string"
        },
        "timeout": {
          "type": "string",
          "minLength": 1
        },
        "allowInsecureHTTP": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "image": {
                "minLength": 1
              },
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "hindsight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "deploymentConfigMap": {
          "type": "string"
        },
        "gatewayURL": {
          "type": "string"
        },
        "embeddingGatewayURL": {
          "type": "string"
        },
        "llmModel": {
          "type": "string"
        },
        "embeddingModel": {
          "type": "string"
        },
        "embeddingDimensions": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "baseURL": {
          "type": "string"
        },
        "timeout": {
          "type": "string",
          "minLength": 1
        },
        "instanceNamespace": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              },
              "deploymentConfigMap": {
                "minLength": 1
              },
              "gatewayURL": {
                "minLength": 1
              },
              "llmModel": {
                "minLength": 1
              },
              "embeddingModel": {
                "minLength": 1
              },
              "embeddingDimensions": {
                "minimum": 1
              },
              "image": {
                "const": "ghcr.io/vectorize-io/hindsight:1.2.0@sha256:19d0c08f3df79acac29384826419a1ca158129e81ec527cdcbd8c97ff4ef76da"
              },
              "instanceNamespace": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["host"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "postgres": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          }
        },
        "required": ["postgres"]
      },
      "then": {
        "properties": {
          "postgres": {
            "properties": {
              "port": {
                "const": 5432
              }
            },
            "required": ["port"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "networkIngestQuery": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["networkIngestQuery"]
          }
        },
        "required": ["config"]
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "networkIngestQuery": {
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "serverName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "networkRuntime": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["networkRuntime"]
      },
      "then": {
        "properties": {
          "networkRuntime": {
            "properties": {
              "existingTLSSecret": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "networkRuntimeService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "moduleToggle": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "initialCredential": {
      "type": "string",
      "minLength": 1
    },
    "systemSecret": {
      "type": "string",
      "minLength": 32
    }
  }
}

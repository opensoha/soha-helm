{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "outpostExecutor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "controlPlaneUrl": {
          "type": "string"
        },
        "executorId": {
          "type": "string"
        },
        "existingTokenSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "execution-runner-token",
              "config.yaml"
            ]
          }
        },
        "signingKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyId": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^\\S*$"
            },
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "outpostId",
              "executorId",
              "uid",
              "namespace",
              "name",
              "templateDigest",
              "maxReplicas",
              "allowAdoption",
              "previousOwnerStopped"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "outpostId": {
                "type": "string",
                "minLength": 1
              },
              "executorId": {
                "type": "string",
                "minLength": 1
              },
              "uid": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "templateDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "maxReplicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "allowAdoption": {
                "type": "boolean"
              },
              "previousOwnerStopped": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "password": {
          "$ref": "#/definitions/initialCredential"
        }
      }
    },
    "networkRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingTLSSecret",
        "control",
        "ingest",
        "ingestPostgres"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingTLSSecret": {
          "type": "string",
          "maxLength": 253
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service"
          ],
          "properties": {
            "service": {
              "$ref": "#/definitions/networkRuntimeService"
            }
          }
        },
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service"
          ],
          "properties": {
            "service": {
              "$ref": "#/definitions/networkRuntimeService"
            }
          }
        },
        "ingestPostgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "database",
            "username",
            "password",
            "storageClass",
            "storageSize"
          ],
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "$ref": "#/definitions/initialCredential"
            },
            "storageClass": {
              "type": "string"
            },
            "storageSize": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "loggerLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "loggerFormat": {
          "type": "string",
          "enum": [
            "json",
            "console"
          ]
        },
        "maxHeaderBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "runtime": {
          "type": "object",
          "properties": {
            "executionRunnerToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "adminPassword": {
              "$ref": "#/definitions/initialCredential"
            },
            "jwtSecret": {
              "$ref": "#/definitions/systemSecret"
            },
            "cli": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "publicURL",
                "allowPassword",
                "deviceTTL",
                "pollInterval",
                "accessTTL",
                "idleTTL",
                "absoluteTTL",
                "createLimit",
                "sourcePendingLimit",
                "activeGrantLimit",
                "sourceAttemptLimit",
                "userAttemptLimit"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "publicURL": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^$|^(https://(\\[[^\\[\\]/?#@\\s\\\\]+\\]|[^/:?#@\\s\\\\\\[\\]]+)(:[0-9]+)?|http://(localhost|127\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|\\[::1\\])(:[0-9]+)?)(/[^?#\\s\\\\]*)?$",
                  "description": "External console URL, including its console prefix. HTTPS is required except for canonical localhost, 127.0.0.0/8 or [::1] loopback addresses. This is separate from config.basePath, which is the API path. Core performs final URL validation."
                },
                "allowPassword": {
                  "type": "boolean"
                },
                "deviceTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Device lifetime, 30s..10m; zero uses the Core default of 5m."
                },
                "pollInterval": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Polling interval, 1s..30s; zero uses the Core default of 5s."
                },
                "accessTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Access lifetime, at least 1s and no greater than idleTTL; zero uses 15m."
                },
                "idleTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Sliding idle lifetime, at least accessTTL and no greater than absoluteTTL; zero uses 168h."
                },
                "absoluteTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ms|s|m|h)([0-9]+(ms|s|m|h))*$",
                  "description": "Absolute lifetime, at least idleTTL and at most 8760h (365 days); zero uses 720h."
                },
                "createLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "sourcePendingLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "activeGrantLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "sourceAttemptLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "userAttemptLimit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": [
                      "enabled"
                    ]
                  },
                  "then": {
                    "properties": {
                      "publicURL": {
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "webhookToken": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        },
        "networkIngestQuery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "url",
            "serverName",
            "existingSecret",
            "timeout",
            "maxResponseBytes"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "maxLength": 2048
            },
            "serverName": {
              "type": "string",
              "maxLength": 253
            },
            "existingSecret": {
              "type": "string",
              "maxLength": 253
            },
            "timeout": {
              "type": "string",
              "minLength": 1
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 4194304
            }
          }
        },
        "modules": {
          "type": "object",
          "properties": {
            "delivery": {
              "$ref": "#/definitions/moduleToggle"
            },
            "monitoring": {
              "$ref": "#/definitions/moduleToggle"
            },
            "ai": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "features": {
                  "type": "object",
                  "properties": {
                    "globalAssistant": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "aiGateway": {
              "$ref": "#/definitions/moduleToggle"
            },
            "virtualization": {
              "$ref": "#/definitions/moduleToggle"
            },
            "docker": {
              "$ref": "#/definitions/moduleToggle"
            },
            "security": {
              "$ref": "#/definitions/moduleToggle"
            },
            "cmdb": {
              "$ref": "#/definitions/moduleToggle"
            }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "credentialEncryptionKey": {
              "$ref": "#/definitions/systemSecret"
            }
          }
        }
      }
    },
    "proxyExecutor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "controlPlaneUrl": {
          "type": "string"
        },
        "executorId": {
          "type": "string"
        },
        "existingTokenSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "execution-runner-token",
              "config.yaml"
            ]
          }
        },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "executorId",
              "uid",
              "namespace",
              "name",
              "templateDigest",
              "maxReplicas",
              "allowAdoption",
              "previousOwnerStopped",
              "proxyId",
              "workloadKind",
              "members",
              "endpoints"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "executorId": {
                "type": "string",
                "minLength": 1
              },
              "uid": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "templateDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "maxReplicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "allowAdoption": {
                "type": "boolean"
              },
              "previousOwnerStopped": {
                "type": "boolean"
              },
              "proxyId": {
                "type": "string",
                "minLength": 1
              },
              "workloadKind": {
                "enum": [
                  "StatefulSet",
                  "Deployment"
                ]
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "instanceId",
                    "runtimeId",
                    "ordinal"
                  ],
                  "properties": {
                    "instanceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "runtimeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ordinal": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127
                    }
                  }
                }
              },
              "endpoints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "endpointId",
                    "url"
                  ],
                  "properties": {
                    "endpointId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://[^/@?#]+$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "proxyRuntime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 50
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "engine": {
          "enum": [
            "mihomo",
            "sing-box",
            "v2ray"
          ]
        },
        "serviceType": {
          "enum": [
            "ClusterIP",
            "LoadBalancer"
          ]
        },
        "members": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "runtimeId",
              "existingSecret"
            ],
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1
              },
              "runtimeId": {
                "type": "string",
                "minLength": 1
              },
              "existingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "image": {
          "type": "string"
        },
        "engineBinary": {
          "type": "string"
        },
        "controlUrl": {
          "type": "string"
        },
        "ingestUrl": {
          "type": "string"
        },
        "endpointId": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "storageSize": {
          "type": "string"
        },
        "existingProbeProfilesSecret": {
          "type": "string"
        }
      }
    },
    "proxyProbeProfiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "profileId"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "profileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      }
    },
    "radiusExecutor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "executorId": {
          "type": "string"
        },
        "existingTokenSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "execution-runner-token",
              "config.yaml"
            ]
          }
        },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "siteId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "nasBindingId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "nasId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "nasName": {
                "type": "string",
                "minLength": 1
              },
              "accessMedium": {
                "enum": [
                  "wired",
                  "wifi"
                ]
              },
              "ssid": {
                "type": "string"
              },
              "executorId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "uid": {
                "type": "string",
                "minLength": 1
              },
              "workloadKind": {
                "enum": [
                  "StatefulSet",
                  "Deployment"
                ]
              },
              "templateDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "serviceAccount": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63
              },
              "maxReplicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "memberId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "runtimeId": {
                      "type": "string",
                      "pattern": "^radius-member:[A-Za-z0-9._:-]+$"
                    },
                    "ordinal": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 127
                    },
                    "endpoint": {
                      "type": "string",
                      "pattern": "^[^/ ]+:[0-9]+$"
                    },
                    "credentialRef": {
                      "type": "string",
                      "pattern": "^secretref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
                    }
                  },
                  "required": [
                    "memberId",
                    "runtimeId",
                    "ordinal",
                    "endpoint",
                    "credentialRef"
                  ]
                }
              },
              "configurations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "material": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "reference": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "treeHash": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "nasSharedSecretRef": {
                          "type": "string",
                          "pattern": "^secretref:[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
                        },
                        "eapServerCertificateRef": {
